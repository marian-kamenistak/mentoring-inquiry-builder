# 1Password -> Cloudflare secret manifest.
# Format:  <1Password item>  <Cloudflare secret name>.  One column = same name both sides.
# Synced by automation/secret-sync/sync-secrets.sh on every `npm run deploy` (predeploy hook).
# Only these are managed; anything else on the Worker is left untouched and never deleted.

ANTHROPIC_API_KEY       ANTHROPIC_API_KEY
ATTIO_TOKEN             ATTIO_TOKEN
MC_BOOKING_HOOK_SECRET  BOOKING_HOOK_SECRET
MC_CHAT_SESSION_SECRET  CHAT_SESSION_SECRET
MC_CLAIM_SECRET         CLAIM_SECRET
# marian.coach sender (leads@marian.coach) -- the MC Resend account, NOT the ELC one.
RESEND_API_KEY_MC       RESEND_API_KEY
SLACK_WEBHOOK_URL       SLACK_WEBHOOK_URL
# "MC Mentoring Chat" widget, sitekey 0x4AAAAAAELQNHYy_EGxLpSL (= MC_TURNSTILE_SITEKEY in vault).
MC_TURNSTILE_SECRET     CHAT_TURNSTILE_SECRET
# Shared bearer secret sent as the x-prep-secret header to mc-web /api/prep-invite. Both Workers
# MUST hold the same value or every prep invite 403s silently. Managed from one vault item on both
# sides since 2026-08-25, so they cannot drift apart.
MC_PREP_INVITE_SECRET   PREP_INVITE_SECRET
# unmanaged: GA4_API_SECRET, GA4_MEASUREMENT_ID
